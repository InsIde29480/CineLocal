# Unité systemd pour lancer CineLocal automatiquement au démarrage.
#
# Installation :
#   1. Adapter User/Group/WorkingDirectory/ExecStart au chemin d'installation.
#      ⚠ WorkingDirectory doit être le dossier qui contient server.py, sinon
#      le service échoue avec « status=200/CHDIR ».
#      Si les dépendances sont dans un venv, pointer ExecStart vers son python :
#        ExecStart=/chemin/vers/CineLocal/.venv/bin/python /chemin/vers/CineLocal/server.py
#   2. sudo cp deploy/cinelocal.service /etc/systemd/system/cinelocal.service
#   3. sudo systemctl daemon-reload
#   4. sudo systemctl enable --now cinelocal
#
# Suivre les logs : sudo journalctl -u cinelocal -f

[Unit]
Description=CineLocal - Serveur de films local
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nas
Group=nas
WorkingDirectory=/home/nas/serveur_films
ExecStart=/usr/bin/python3 /home/nas/serveur_films/server.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cinelocal

# Sécurité
NoNewPrivileges=true
PrivateTmp=true
MemoryMax=80%

[Install]
WantedBy=multi-user.target
